// =============================================================================
// Claude Code hooks snippet for cc-status.js
// =============================================================================
// Copy the "hooks" object below and merge it into your ~/.claude/settings.json
// (merge top-level keys with any hooks you already have).
//
// How it works: for each event, CC pipes a JSON payload on stdin to cc-status.js,
// which writes a per-session status file to:
//     ~/.claude/cc-tab-status/<session_id>.json   =  { state, since, error? }
//
// States written: running | done | interrupted
//   (idle is inferred by the reader when no file exists / done > 5 min;
//    permission is left to CC's native blue pending dot — NOT wired here.
//    This event set MUST equal HOOK_EVENTS in patch.ts; see docs/STATES.md §2.)
//
// NOTE on the command path: it must point at where you keep cc-status.js.
// The absolute path below matches the default location in this repo; update it
// if you move the script. The path contains no spaces, so no quoting is needed,
// but quote it if you relocate it under a directory with spaces.
// =============================================================================
{
  "hooks": {

    // ---- New user prompt submitted -> CC starts running the turn ----
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/wangdong/Documents/Project/vscode-cc-提示插件/claude-code-status-dot/hooks/cc-status.js"
          }
        ]
      }
    ],

    // ---- Tool about to run -> heartbeat, keep state "running" ----
    "PreToolUse": [
      {
        "matcher": "",  // "" matches every tool; narrow with e.g. "Bash|Edit" if desired
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/wangdong/Documents/Project/vscode-cc-提示插件/claude-code-status-dot/hooks/cc-status.js"
          }
        ]
      }
    ],

    // ---- Tool finished -> heartbeat, keep state "running" ----
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/wangdong/Documents/Project/vscode-cc-提示插件/claude-code-status-dot/hooks/cc-status.js"
          }
        ]
      }
    ],

    // ---- Turn finished normally -> state "done" ----
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/wangdong/Documents/Project/vscode-cc-提示插件/claude-code-status-dot/hooks/cc-status.js"
          }
        ]
      }
    ],

    // ---- Turn aborted/interrupted -> state "interrupted" (records error enum) ----
    // NOTE: "StopFailure" is handled defensively by the script. If your CC build
    // does not emit this event, this entry is simply ignored.
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/wangdong/Documents/Project/vscode-cc-提示插件/claude-code-status-dot/hooks/cc-status.js"
          }
        ]
      }
    ],

    // ---- Session ends -> delete that session's status file ----
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/wangdong/Documents/Project/vscode-cc-提示插件/claude-code-status-dot/hooks/cc-status.js"
          }
        ]
      }
    ]

  }
}
