{
  "name": "vscode-claude-code-status-dot",
  "version": "0.1.14",
  "description": "Colorize Claude Code's VSCode tab icon with 4-state status dots (idle/running/done/interrupted) and add a bottom status-bar 4-light aggregate (done/running/pending/interrupted) via a minimal, reversible patch.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "vscode-claude-code-status-dot": "dist/patch.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "patch": "npx tsx patch.ts",
    "revert": "npx tsx patch.ts --revert",
    "status": "npx tsx patch.ts --status",
    "test": "node hooks/test-cc-status.js && node hooks/test-iife.mjs && node hooks/test-sbi-aggregation.mjs && node hooks/test-smoke-journey.mjs",
    "test:writer": "node hooks/test-cc-status.js",
    "test:reader": "node hooks/test-iife.mjs",
    "test:aggregation": "node hooks/test-sbi-aggregation.mjs",
    "test:smoke": "node hooks/test-smoke-journey.mjs",
    "format:check": "prettier --check patch.ts hooks/**/*.js hooks/**/*.mjs",
    "format": "prettier --write patch.ts hooks/**/*.js hooks/**/*.mjs",
    "prepare": "husky"
  },
  "keywords": [
    "claude-code",
    "vscode",
    "claude",
    "status-indicator",
    "patch"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangdong233/vscode-claude-code-status-dot.git"
  },
  "homepage": "https://github.com/wangdong233/vscode-claude-code-status-dot#readme",
  "bugs": {
    "url": "https://github.com/wangdong233/vscode-claude-code-status-dot/issues"
  },
  "author": "wangdong",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "resources/*.svg",
    "hooks/",
    "docs/",
    "*.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "devDependencies": {
    "@types/node": "^20.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.3.0",
    "typescript": "^5.4.0"
  },
  "lint-staged": {
    "patch.ts": "prettier --check",
    "hooks/**/*.js": "prettier --check",
    "hooks/**/*.mjs": "prettier --check"
  }
}
