{
  "name": "vscode-claude-code-status-dot",
  "version": "0.5.13",
  "description": "Colorize Claude Code's VSCode tab icon with 4-state status dots (idle/running/done/interrupted), add a bottom status-bar 4-light aggregate (done/running/pending/interrupted), and surface per-session token usage / cost on the right side of the status bar — all via a minimal, reversible patch.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "vscode-claude-code-status-dot": "dist/patch.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build && npm run companion:install && npm run companion:build && npm run companion:package && cp companion/cc-status-dot-companion-*.vsix dist/ && node hooks/assert-companion-vsix.mjs",
    "patch": "npx tsx patch.ts",
    "revert": "npx tsx patch.ts --revert",
    "status": "npx tsx patch.ts --status",
    "test": "node hooks/test-cc-status.js && node hooks/test-iife.mjs && node hooks/test-sbi-aggregation.mjs && node hooks/test-smoke-journey.mjs && node hooks/test-patcher-io.mjs && node hooks/test-version-sync.mjs && node hooks/test-contract-sync.mjs && node hooks/test-favorites.mjs && node hooks/test-smoke-favorites.mjs && node hooks/test-standalone-patch.mjs",
    "test:writer": "node hooks/test-cc-status.js",
    "test:reader": "node hooks/test-iife.mjs",
    "test:aggregation": "node hooks/test-sbi-aggregation.mjs",
    "test:smoke": "node hooks/test-smoke-journey.mjs",
    "test:patcher-io": "node hooks/test-patcher-io.mjs",
    "test:version-sync": "node hooks/test-version-sync.mjs",
    "test:contract-sync": "node hooks/test-contract-sync.mjs",
    "test:favorites": "node hooks/test-favorites.mjs",
    "test:smoke-favorites": "node hooks/test-smoke-favorites.mjs",
    "test:standalone": "node hooks/test-standalone-patch.mjs",
    "companion:install": "cd companion && npm install --no-audit --no-fund",
    "companion:build": "cd companion && npm run build",
    "companion:package": "cd companion && npm run package:vsix",
    "format:check": "prettier --check patch.ts hooks/**/*.js hooks/**/*.mjs companion/extension.ts",
    "format": "prettier --write patch.ts hooks/**/*.js hooks/**/*.mjs companion/extension.ts",
    "prepare": "husky"
  },
  "keywords": [
    "claude-code",
    "vscode",
    "claude",
    "status-indicator",
    "patch"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangdong233/vscode-claude-code-status-dot.git"
  },
  "homepage": "https://github.com/wangdong233/vscode-claude-code-status-dot#readme",
  "bugs": {
    "url": "https://github.com/wangdong233/vscode-claude-code-status-dot/issues"
  },
  "author": "wangdong",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "resources/*.svg",
    "hooks/cc-status.js",
    "docs/",
    "*.md",
    "LICENSE",
    "tsconfig.json",
    "companion/"
  ],
  "devDependencies": {
    "@types/node": "^20.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.3.0",
    "typescript": "^5.4.0"
  },
  "lint-staged": {
    "patch.ts": "prettier --check",
    "hooks/**/*.js": "prettier --check",
    "hooks/**/*.mjs": "prettier --check",
    "companion/extension.ts": "prettier --check"
  }
}
