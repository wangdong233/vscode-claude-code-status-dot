{
  "name": "vscode-claude-code-status-dot",
  "version": "0.1.7",
  "description": "Colorize Claude Code's VSCode tab icon with 4-state status dots (idle/running/done/interrupted) via a minimal, reversible patch.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "vscode-claude-code-status-dot": "dist/patch.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "patch": "npx tsx patch.ts",
    "revert": "npx tsx patch.ts --revert",
    "status": "npx tsx patch.ts --status",
    "test": "node hooks/test-cc-status.js"
  },
  "keywords": [
    "claude-code",
    "vscode",
    "claude",
    "status-indicator",
    "patch"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangdong233/vscode-claude-code-status-dot.git"
  },
  "homepage": "https://github.com/wangdong233/vscode-claude-code-status-dot#readme",
  "bugs": {
    "url": "https://github.com/wangdong233/vscode-claude-code-status-dot/issues"
  },
  "author": "wangdong",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "resources/*.svg",
    "hooks/",
    "docs/",
    "*.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  }
}
