{
  "name": "cc-status-dot-companion",
  "displayName": "%ccsd.displayName%",
  "description": "%ccsd.description%",
  "version": "0.5.31",
  "publisher": "wangdong",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:ccStatusDot.favorites"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "ccStatusDot.favorites",
          "name": "%ccsd.fav.viewName%",
          "icon": "$(star-full)",
          "contextualTitle": "%ccsd.fav.viewContextualTitle%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ccStatusDot.favorites",
        "contents": "%ccsd.fav.viewsWelcomeContents%",
        "when": "ccStatusDot.favoritesEmpty == true"
      }
    ],
    "commands": [
      {
        "command": "ccStatusDot.fav.toggleFile",
        "title": "%ccsd.fav.toggleFile.title%",
        "icon": "$(star-full)",
        "category": "%ccsd.fav.category%"
      },
      {
        "command": "ccStatusDot.fav.toggleTab",
        "title": "%ccsd.fav.toggleTab.title%",
        "icon": "$(star-full)",
        "category": "%ccsd.fav.category%"
      },
      {
        "command": "ccStatusDot.fav.addTab",
        "title": "%ccsd.fav.addTab.title%",
        "icon": "$(star-add)",
        "category": "%ccsd.fav.category%"
      },
      {
        "command": "ccStatusDot.fav.removeTab",
        "title": "%ccsd.fav.removeTab.title%",
        "icon": "$(star-trash)",
        "category": "%ccsd.fav.category%"
      },
      {
        "command": "ccStatusDot.fav.open",
        "title": "%ccsd.fav.open.title%",
        "icon": "$(go-to-file)",
        "category": "%ccsd.fav.category%"
      },
      {
        "command": "ccStatusDot.fav.remove",
        "title": "%ccsd.fav.remove.title%",
        "icon": "$(close)",
        "category": "%ccsd.fav.category%"
      },
      {
        "command": "ccStatusDot.fav.copyResume",
        "title": "%ccsd.fav.copyResume.title%",
        "icon": "$(copy)",
        "category": "%ccsd.fav.category%"
      },
      {
        "command": "ccStatusDot.fav.refresh",
        "title": "%ccsd.fav.refresh.title%",
        "icon": "$(refresh)",
        "category": "%ccsd.fav.category%"
      },
      {
        "command": "ccStatusDot.fav.browse",
        "title": "%ccsd.fav.browse.title%",
        "icon": "$(list-filter)",
        "category": "%ccsd.fav.category%"
      },
      {
        "command": "ccStatusDot.fav.pickSession",
        "title": "%ccsd.fav.pickSession.title%",
        "icon": "$(star-empty)",
        "category": "%ccsd.fav.category%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "ccStatusDot.fav.toggleFile",
          "when": "!explorerResourceIsFolder && config.ccStatusDot.fav.includeInExplorerContextMenu",
          "group": "ccsd_favorites@1"
        },
        {
          "command": "ccStatusDot.fav.addTab",
          "when": "resourceScheme != 'file' && !ccStatusDot.fav.currentTabFavorited && config.ccStatusDot.fav.includeInExplorerContextMenu",
          "group": "ccsd_favorites@3"
        },
        {
          "command": "ccStatusDot.fav.removeTab",
          "when": "resourceScheme != 'file' && ccStatusDot.fav.currentTabFavorited && config.ccStatusDot.fav.includeInExplorerContextMenu",
          "group": "ccsd_favorites@4"
        }
      ],
      "view/title": [
        {
          "command": "ccStatusDot.fav.refresh",
          "when": "view == ccStatusDot.favorites",
          "group": "navigation@1"
        },
        {
          "command": "ccStatusDot.fav.browse",
          "when": "view == ccStatusDot.favorites",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "ccStatusDot.fav.open",
          "when": "view == ccStatusDot.favorites && viewItem =~ /^ccsdFav(SessionOpen|File)$/",
          "group": "inline@1"
        },
        {
          "command": "ccStatusDot.fav.remove",
          "when": "view == ccStatusDot.favorites && viewItem =~ /^ccsdFav/",
          "group": "inline@2"
        },
        {
          "command": "ccStatusDot.fav.copyResume",
          "when": "view == ccStatusDot.favorites && viewItem =~ /^ccsdFavSession/",
          "group": "9_cuts@1"
        }
      ],
      "commandPalette": [
        {
          "command": "ccStatusDot.fav.toggleFile",
          "when": "resourceLangId != undefined"
        },
        {
          "command": "ccStatusDot.fav.toggleTab"
        },
        {
          "command": "ccStatusDot.fav.pickSession"
        },
        {
          "command": "ccStatusDot.fav.addTab",
          "when": "false"
        },
        {
          "command": "ccStatusDot.fav.removeTab",
          "when": "false"
        },
        {
          "command": "ccStatusDot.fav.refresh",
          "when": "view == ccStatusDot.favorites"
        },
        {
          "command": "ccStatusDot.fav.browse",
          "when": "view == ccStatusDot.favorites"
        },
        {
          "command": "ccStatusDot.fav.open",
          "when": "false"
        },
        {
          "command": "ccStatusDot.fav.remove",
          "when": "false"
        },
        {
          "command": "ccStatusDot.fav.copyResume",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%ccsd.configuration.title%",
      "properties": {
        "ccStatusDot.notify": {
          "type": "boolean",
          "default": true,
          "description": "%ccsd.config.notify.description%"
        },
        "ccStatusDot.notifyWhenFocused": {
          "type": "boolean",
          "default": true,
          "description": "%ccsd.config.notifyWhenFocused.description%"
        },
        "ccStatusDot.notifySound": {
          "type": "string",
          "enum": [
            "Basso",
            "Bell",
            "Blow",
            "Bottle",
            "Frog",
            "Funk",
            "Glass",
            "Hero",
            "Morse",
            "Ping",
            "Pop",
            "Purr",
            "Sosumi",
            "Submarine",
            "Tink"
          ],
          "default": "Glass",
          "description": "%ccsd.config.notifySound.description%"
        },
        "ccStatusDot.tokenStatsWindow": {
          "type": "string",
          "enum": [
            "5min",
            "10min",
            "1h",
            "24h",
            "3d",
            "7d",
            "30d",
            "all"
          ],
          "default": "all",
          "description": "%ccsd.config.tokenStatsWindow.description%"
        },
        "ccStatusDot.tokenDisplayMode": {
          "type": "string",
          "enum": [
            "token",
            "cost",
            "both"
          ],
          "default": "both",
          "description": "%ccsd.config.tokenDisplayMode.description%"
        },
        "ccStatusDot.tokenSbiVisible": {
          "type": "boolean",
          "default": true,
          "description": "%ccsd.config.tokenSbiVisible.description%"
        },
        "ccStatusDot.tokenLiveDeltaEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%ccsd.config.tokenLiveDeltaEnabled.description%"
        },
        "ccStatusDot.showCost": {
          "type": "boolean",
          "default": true,
          "description": "%ccsd.config.showCost.description%"
        },
        "ccStatusDot.warnThresholdUsd": {
          "type": "number",
          "default": 0,
          "description": "%ccsd.config.warnThresholdUsd.description%"
        },
        "ccStatusDot.rateDisplayMode": {
          "type": "string",
          "enum": [
            "off",
            "numeric",
            "sparkline",
            "both"
          ],
          "default": "numeric",
          "description": "%ccsd.config.rateDisplayMode.description%"
        },
        "ccStatusDot.fav.includeInExplorerContextMenu": {
          "type": "boolean",
          "default": true,
          "description": "%ccsd.config.fav.includeInExplorerContextMenu.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "package:vsix": "vsce package --no-dependencies -o cc-status-dot-companion-$npm_package_version.vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.84.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangdong233/vscode-claude-code-status-dot.git",
    "directory": "companion"
  },
  "homepage": "https://github.com/wangdong233/vscode-claude-code-status-dot#readme",
  "bugs": {
    "url": "https://github.com/wangdong233/vscode-claude-code-status-dot/issues"
  },
  "author": "wangdong"
}
