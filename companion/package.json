{
  "name": "cc-status-dot-companion",
  "displayName": "cc-status-dot Companion",
  "description": "Detects Claude Code extension auto-updates and silently re-applies the cc-status-dot patch, plus a CC Favorites view for pinning files and CC sessions (v0.4.0+). Ships inside the vscode-claude-code-status-dot npm package — install via: npx vscode-claude-code-status-dot",
  "version": "0.4.0",
  "publisher": "wangdong",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:ccStatusDot.favorites"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "ccStatusDot.favorites",
          "name": "CC Favorites",
          "icon": "$(star-full)",
          "contextualTitle": "CC Favorites"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ccStatusDot.favorites",
        "contents": "No favorites yet.\nRight-click a file in Explorer to add it.\n[Refresh](command:ccStatusDot.fav.refresh)\nTo favorite the active Claude Code session, run **CC Favorites: Star/Unstar Current CC Tab** from the Command Palette.",
        "when": "ccStatusDot.favoritesEmpty == true"
      }
    ],
    "commands": [
      {
        "command": "ccStatusDot.fav.toggleFile",
        "title": "CC Favorites: Add/Remove File",
        "icon": "$(star-full)",
        "category": "CC Favorites"
      },
      {
        "command": "ccStatusDot.fav.toggleTab",
        "title": "CC Favorites: Star/Unstar Current CC Tab",
        "icon": "$(star-full)",
        "category": "CC Favorites"
      },
      {
        "command": "ccStatusDot.fav.open",
        "title": "CC Favorites: Open",
        "icon": "$(go-to-file)",
        "category": "CC Favorites"
      },
      {
        "command": "ccStatusDot.fav.remove",
        "title": "CC Favorites: Remove",
        "icon": "$(close)",
        "category": "CC Favorites"
      },
      {
        "command": "ccStatusDot.fav.copyResume",
        "title": "CC Favorites: Copy 'claude -r <sid>'",
        "icon": "$(copy)",
        "category": "CC Favorites"
      },
      {
        "command": "ccStatusDot.fav.refresh",
        "title": "CC Favorites: Refresh",
        "icon": "$(refresh)",
        "category": "CC Favorites"
      },
      {
        "command": "ccStatusDot.fav.browse",
        "title": "CC Favorites: Browse",
        "icon": "$(list-filter)",
        "category": "CC Favorites"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "ccStatusDot.fav.toggleFile",
          "when": "!explorerResourceIsFolder && config.ccStatusDot.fav.includeInExplorerContextMenu",
          "group": "ccsd_favorites@1"
        }
      ],
      "view/title": [
        {
          "command": "ccStatusDot.fav.refresh",
          "when": "view == ccStatusDot.favorites",
          "group": "navigation@1"
        },
        {
          "command": "ccStatusDot.fav.browse",
          "when": "view == ccStatusDot.favorites",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "ccStatusDot.fav.open",
          "when": "view == ccStatusDot.favorites && viewItem =~ /^ccsdFav(SessionOpen|File)$/",
          "group": "inline@1"
        },
        {
          "command": "ccStatusDot.fav.remove",
          "when": "view == ccStatusDot.favorites && viewItem =~ /^ccsdFav/",
          "group": "inline@2"
        },
        {
          "command": "ccStatusDot.fav.copyResume",
          "when": "view == ccStatusDot.favorites && viewItem =~ /^ccsdFavSession/",
          "group": "9_cuts@1"
        }
      ],
      "commandPalette": [
        {
          "command": "ccStatusDot.fav.toggleFile",
          "when": "resourceLangId != undefined"
        },
        {
          "command": "ccStatusDot.fav.toggleTab"
        },
        {
          "command": "ccStatusDot.fav.refresh",
          "when": "view == ccStatusDot.favorites"
        },
        {
          "command": "ccStatusDot.fav.browse",
          "when": "view == ccStatusDot.favorites"
        },
        {
          "command": "ccStatusDot.fav.open",
          "when": "false"
        },
        {
          "command": "ccStatusDot.fav.remove",
          "when": "false"
        },
        {
          "command": "ccStatusDot.fav.copyResume",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "cc-status-dot",
      "properties": {
        "ccStatusDot.notify": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when Claude Code completes a turn (state transitions to done or interrupted)."
        },
        "ccStatusDot.notifyWhenFocused": {
          "type": "boolean",
          "default": true,
          "description": "Also fire the completion notification when VSCode is the currently focused window. Disable to only notify when you're in another app."
        },
        "ccStatusDot.notifySound": {
          "type": "string",
          "enum": [
            "Basso",
            "Bell",
            "Blow",
            "Bottle",
            "Frog",
            "Funk",
            "Glass",
            "Hero",
            "Morse",
            "Ping",
            "Pop",
            "Purr",
            "Sosumi",
            "Submarine",
            "Tink"
          ],
          "default": "Glass",
          "description": "macOS system sound to play on completion notification (ignored on Linux/Windows)."
        },
        "ccStatusDot.tokenStatsWindow": {
          "type": "string",
          "enum": [
            "5min",
            "10min",
            "1h",
            "24h",
            "3d",
            "7d",
            "30d",
            "all"
          ],
          "default": "all",
          "description": "Time window for the right-side token stats status bar item. 'all' = cumulative (never resets, default); the rolling windows (5min..30d) naturally age out old turns. Match this default with the IIFE cfg.get fallback (pin enforced by test-version-sync.mjs)."
        },
        "ccStatusDot.tokenDisplayMode": {
          "type": "string",
          "enum": [
            "token",
            "cost",
            "both"
          ],
          "default": "both",
          "description": "What to show on the token stats SBI: token count only, USD cost only, or both."
        },
        "ccStatusDot.tokenSbiVisible": {
          "type": "boolean",
          "default": true,
          "description": "Show the token stats status bar item on the right side."
        },
        "ccStatusDot.tokenLiveDeltaEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Read the active session's transcript tail every tick so token counts update during streaming (between hook fires). Disable on perf-sensitive machines."
        },
        "ccStatusDot.showCost": {
          "type": "boolean",
          "default": true,
          "description": "Show the USD cost estimate alongside the token count (requires a matching model entry in token-rates.json — unknown models like GLM are auto-hidden)."
        },
        "ccStatusDot.warnThresholdUsd": {
          "type": "number",
          "default": 0,
          "description": "Notify when the session cost estimate crosses this USD threshold (0 = disabled). Fires once per crossing."
        },
        "ccStatusDot.rateDisplayMode": {
          "type": "string",
          "enum": [
            "off",
            "numeric",
            "sparkline",
            "both"
          ],
          "default": "both",
          "description": "How to render the live tok/s suffix on the token status bar item: 'off' hides it (for crowded bars / perf-sensitive machines), 'numeric' shows only '1.2k/s', 'sparkline' shows only '▂▄▆█', 'both' (default) shows both."
        },
        "ccStatusDot.fav.includeInExplorerContextMenu": {
          "type": "boolean",
          "default": true,
          "description": "Show 'CC Favorites: Add/Remove File' in the Explorer file right-click menu."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "package:vsix": "vsce package --no-dependencies -o cc-status-dot-companion-$npm_package_version.vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.84.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangdong233/vscode-claude-code-status-dot.git",
    "directory": "companion"
  },
  "homepage": "https://github.com/wangdong233/vscode-claude-code-status-dot#readme",
  "bugs": {
    "url": "https://github.com/wangdong233/vscode-claude-code-status-dot/issues"
  },
  "author": "wangdong"
}
