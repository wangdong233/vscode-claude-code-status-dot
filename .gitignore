# Dependencies
node_modules/

# Patch backups & generated artifacts
*.bak
*.orig
*.bak.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/

# Build output
dist/
build/

# Companion VS Code extension artifacts (built at release time via
# `npm run companion:package`; the .vsix is shipped via npm `files` but is
# NOT committed — regenerate from source).
companion/dist/
companion/node_modules/
companion/*.vsix

# DevTeam plugin artifacts (must never be committed)
.devteam/
*.db

# npm pack artifacts
*.tgz
